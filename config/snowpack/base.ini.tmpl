; SNOWPACK / MeteoIO configuration for one GROOMRS model point.
; Double-brace placeholders are filled per run by src/snowpack/config.ts.
; Flat, open-field, natural-snow column (no soil, no canopy, no technical snow).

[General]
BUFFER_SIZE = 370
BUFF_BEFORE = 1.5

[Input]
COORDSYS = CH1903
TIME_ZONE = 0
METEO = SMET
METEOPATH = {{INPUT_DIR}}
STATION1 = {{STATION}}
SNOWPATH = {{INPUT_DIR}}
SNOWFILE1 = {{STATION}}

[Output]
COORDSYS = CH1903
TIME_ZONE = 0
METEOPATH = {{OUTPUT_DIR}}
SNOW = SMET
SNOWPATH = {{OUTPUT_DIR}}
SNOW_WRITE = true
EXPERIMENT = run
TS_WRITE = true
TS_FORMAT = SMET
TS_START = 0.0
; hourly time series
TS_DAYS_BETWEEN = 0.04166667
PROF_WRITE = {{PROF_WRITE}}
PROF_FORMAT = PRO
AGGREGATE_PRF = false
PROF_START = 0.0
PROF_DAYS_BETWEEN = {{PROF_DAYS_BETWEEN}}

[Snowpack]
; No measured surface temperature or snow height: SNOWPACK computes both
; from the energy balance and precipitation.
MEAS_TSS = false
ENFORCE_MEASURED_SNOW_HEIGHTS = false
SW_MODE = INCOMING
; Open-Meteo wind is at 10 m, temperature and humidity at 2 m.
HEIGHT_OF_WIND_VALUE = 10.0
HEIGHT_OF_METEO_VALUES = 2.0
; MO_HOLTSLAG (used in SLF's research examples, which have measured surface
; temperatures) diverges on a ~1 cm snowpack under dry air: latent cooling
; pins at -250 W/m2 and the surface runs to -87 degC ("Temperature out of
; bound"). MO_MICHLMAYR stays stable without measured TSS.
ATMOSPHERIC_STABILITY = MO_MICHLMAYR
ROUGHNESS_LENGTH = 0.002
CALCULATION_STEP_LENGTH = 15.0
CHANGE_BC = false
THRESH_CHANGE_BC = -1.0
SNP_SOIL = false
SOIL_FLUX = false
GEO_HEAT = 0.06
CANOPY = false

[SnowpackAdvanced]

[Generators]
; Incoming longwave isn't provided by Open-Meteo; derive it from air
; temperature, humidity and cloud cover (CLD, oktas).
ILWR::generator1 = ALLSKY_LW
ILWR::arg1::type = UNSWORTH
; Bottom boundary for a snow column on unfrozen ground.
TSG::generator1 = CST
TSG::arg1::value = 273.15
; Fills the precipitation phase wherever Open-Meteo's rain/snow split is
; missing (dry hours, or variables absent from the model archive).
PSUM_PH::generator1 = PRECSPLITTING
PSUM_PH::arg1::type = THRESH
PSUM_PH::arg1::snow = 274.35

[Filters]
PSUM::filter1 = min
PSUM::arg1::soft = true
PSUM::arg1::min = 0.0
RH::filter1 = min_max
RH::arg1::soft = true
RH::arg1::min = 0.05
RH::arg1::max = 1.0
ISWR::filter1 = min_max
ISWR::arg1::soft = true
ISWR::arg1::min = 0
ISWR::arg1::max = 1500

[Interpolations1D]
WINDOW_SIZE = 86400
PSUM::resample = accumulate
PSUM::accumulate::period = 900
VW::resample = nearest
VW::nearest::extrapolate = true
DW::resample = nearest
DW::nearest::extrapolate = true
